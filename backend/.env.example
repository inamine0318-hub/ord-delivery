# ===== Square =====
# 本番投入時、Webhook署名検証(x-square-hmacsha256-signature)に使用。
# モック実装では未検証（README「本番投入前の注意」を参照）。
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ===== LINE Messaging API =====
# 本番投入時にLINE Developersコンソールで発行したチャネルアクセストークンを設定。
# 未設定、またはMOCK_MODE=trueの間は実際の送信は行わずコンソールログのみ。
LINE_CHANNEL_ACCESS_TOKEN=
MERCHANT_LINE_USER_ID=
DRIVER_LINE_USER_ID=

# true = LINEへ実送信せずコンソールログのみ（デフォルト・推奨）
# false = 実際にLINE Messaging APIへ送信する（要:上記トークン設定）
MOCK_MODE=true

PORT=3001
