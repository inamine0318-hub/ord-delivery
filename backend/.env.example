# ===== Server =====
PORT=3001

# ===== Square =====
# 本番投入時、Square Developerダッシュボードで発行したアクセストークンを設定。
# 未設定の間は Square Orders API への実接続を行わず、Webhookペイロードの
# データのみを使用する安全なモック動作になります。
SQUARE_ACCESS_TOKEN=
# Square Clientの接続先環境。'sandbox' または 'production' のみ有効（他の値は起動時にエラーになります）。
# 未設定の場合は安全側のデフォルトとして 'sandbox' として扱われます。
SQUARE_ENVIRONMENT=sandbox
# CreatePaymentLink等でSquare Orderを作成する際に必須となるSquare Location ID。
# 秘密情報ではありませんが、実際の値はSquare Developer Consoleで確認して設定してください
# （このプロジェクトが勝手に生成・推測することはありません）。STEP2-C-7A時点ではまだ
# Square決済機能自体を実装していないため、未設定のままでも既存機能には影響しません。
SQUARE_LOCATION_ID=
# 本番投入時、Webhook署名検証(x-square-hmacsha256-signature)に使用。
# モック実装では未検証（README「本番投入前の注意」を参照）。
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Square Developerコンソールに登録するWebhook通知先の本番公開URL（例:https://.../webhooks/square）。
# 署名検証の計算式に必須（Square仕様上、登録URLと一致しないと検証できない）。
# STEP2-C-6時点では署名検証自体は既存Webhookに未接続のため、この変数もまだ参照されていません。
SQUARE_WEBHOOK_NOTIFICATION_URL=
# Square Payment Linkでの決済後、お客様をORD側へ戻すためのリダイレクト先URL（例:https://.../thanks）。
# 未設定の場合、checkoutOptions.redirectUrlを指定せずにPayment Linkを生成します
# （その場合はSquareの既定の決済完了ページが表示されます）。Sandbox/Production用に
# それぞれ適切な値を設定してください（このプロジェクトが推測して値を生成することはありません）。
ORD_CHECKOUT_REDIRECT_URL=

# ===== Google Maps (Routes API) =====
# 本番投入時、Google Cloud ConsoleでRoutes API用に発行したAPIキーを設定してください
# （Backend専用。index.html等のブラウザ側コードには絶対に渡さないでください）。
# 未設定の間は googleMapsClient.ts が「NOT_ATTEMPTED」を返し、実際のAPI通信は
# 一切行いません（STEP2-D-3-C-1時点ではまだcheckout/dispatchに未接続のため、
# 未設定のままでも既存機能には影響しません）。
GOOGLE_MAPS_API_KEY=

# ===== LINE Messaging API =====
# 本番投入時、LINE Developersコンソールで発行したチャネルアクセストークンを設定。
# 未設定の間は実際の送信は行わずコンソールログのみになります。
LINE_CHANNEL_ACCESS_TOKEN=
# 【2026-09-23追加】LINE Developersコンソールの「チャネル基本設定」にある「チャネルシークレット」。
# /webhooks/lineに届くWebhookが本物のLINEからのものか検証するために使用する（x-line-signature検証）。
# 未設定の間は検証をスキップし、コンソールに警告を出す（ローカル開発・テスト用の動作）。
# 実際にLINE公式アカウントのWebhook URLをこのbackendに向ける前に、必ず設定すること。
LINE_CHANNEL_SECRET=
# 運営アラート（注文未手配・加盟店未確認・配送パートナー未応答）を受け取る運営用LINEアカウントのUser ID（任意）。
# 未設定の場合、アラートは/admin画面とコンソールログにのみ表示されます。
OPS_LINE_USER_ID=

# ===== 認証 =====
# JWTの署名に使う秘密鍵。本番投入前に必ず長いランダム文字列へ変更してください。
# 未設定の場合は開発用の固定値にフォールバックし、起動時に警告が表示されます。
JWT_SECRET=
